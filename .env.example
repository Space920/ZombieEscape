# Optional: persistent stats directory (use /data on Railway with a volume)
# STATS_DATA_DIR=/data

# Required in production for visitor hash salting
# STATS_SALT=generate-a-long-random-string

# Optional: Plausible Analytics (https://plausible.io)
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=zeservers.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Live data providers — leave as unknown_contact_dev unless you have access
LIVE_FALLBACK_URL=unknown_contact_dev
HISTORY_GRAPH_URL=unknown_contact_dev
MAP_PROGRESS_MAPEADORES_CSV=unknown_contact_dev
MAP_PROGRESS_GFL_CSV=unknown_contact_dev
